generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Important for Neon
}

enum MedicineForm {
  CAPSULE
  TABLET
  LIQUID
  POWDER
  GUMMY
  INJECTION
  TOPICAL
  OTHER
}

enum Frequency {
  DAILY
  WEEKLY
  AS_NEEDED
}

model Pill {
  id          Int          @id @default(autoincrement())
  
  name        String
  form        MedicineForm @default(CAPSULE)
  amount      Int          @default(1)
  unit        String
  frequency   Frequency    @default(DAILY)
  timesPerDay Int          @default(1)
  currentStock Int?
  description String?
  
  // --- NEW RELATIONSHIP ---
  logs        IntakeLog[]  

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// --- NEW TABLE ---
model IntakeLog {
  id        Int      @id @default(autoincrement())
  takenAt   DateTime @default(now()) // The exact time you clicked the button
  
  // The Link Back
  pillId    Int
  pill      Pill     @relation(fields: [pillId], references: [id], onDelete: Cascade)
}